+/* pcjs-vax MMU differential-test support
+   ---------------------------------------
+   Two additive facilities, both inert unless explicitly used, that let
+   machines/dec/vax/tests/mmudiff.js grade a JavaScript port of vax_mmu.[ch]
+   against this simulator:
+
+   SHOW CPU MMUOP=op:va:lnt:mode[:val]      (colon separated -- SHOW splits on comma)
+        Performs exactly ONE memory-management operation and prints one
+        machine-readable line.  op 0 = Test with read access, 1 = Test with
+        write access, 2 = Read, 3 = Write, 4 = MTPR (va is the value written
+        and the trailing field is the IPR number, so the test can drive the
+        REAL MTPR handler -- and therefore SIMH's own TB-invalidation and
+        set_map_reg rules -- rather than a console register deposit, which
+        bypasses both).  mode 0..3 = K/E/S/U.  Read and
+        Write abort through the CPU's fault path, so this routine owns a
+        setjmp of its own; without it a translation fault would longjmp into
+        a stale sim_instr frame.
+
+   SET CPU MMUTRACE=<file> / SET CPU NOMMUTRACE
+        Opens the sink the PCJS_MMU_T hooks in vax_mmu.[ch] write to.  Those
+        hooks are single NULL tests when the sink is closed.
+
+   Neither changes any instruction semantics. */
+
+t_stat cpu_show_mmuop (FILE *of, UNIT *uptr, int32 val, CONST void *desc)
+{
+const char *cptr = (const char *) desc;
+static volatile int32 op, lnt, md, acc, dat;
+static volatile uint32 va;
+int32 st, abortval, opnd[2];
+unsigned int a_op, a_lnt, a_md, a_va, a_dat;
+int n;
+
+if (cptr == NULL)
+    return SCPE_ARG;
+a_dat = 0;
+n = sscanf (cptr, "%u:%x:%u:%u:%x", &a_op, &a_va, &a_lnt, &a_md, &a_dat);
+if (n < 4)
+    return SCPE_ARG;
+op = (int32) a_op;
+va = (uint32) a_va;
+lnt = (int32) a_lnt;
+md = (int32) (a_md & 3);
+dat = (int32) a_dat;
+if ((lnt != L_BYTE) && (lnt != L_WORD) && (lnt != L_LONG))
+    return SCPE_ARG;
+set_map_reg ();                                         /* refresh dynamic map regs */
+acc = (op == 1) || (op == 3) ? (ACC_MASK (md) << TLB_V_WACC) : ACC_MASK (md);
+
+abortval = setjmp (save_env);                           /* set abort handler */
+if (abortval != 0) {
+    fprintf (of, "MMUOP %d %08X %d %08X abort %d %08X %08X\n",
+        op, va, lnt, acc, abortval, p1, p2);
+    return SCPE_OK;
+    }
+switch (op) {
+
+    case 0:
+    case 1:
+        st = PR_OK;
+        val = Test (va, acc, &st);
+        if (st == PR_OK)
+            fprintf (of, "MMUOP %d %08X %d %08X ok %08X\n", op, va, lnt, acc, val);
+        else fprintf (of, "MMUOP %d %08X %d %08X stat %d\n", op, va, lnt, acc, st);
+        break;
+
+    case 2:
+        val = Read (va, lnt, acc);
+        fprintf (of, "MMUOP %d %08X %d %08X ok %08X\n", op, va, lnt, acc, val);
+        break;
+
+    case 3:
+        Write (va, dat, lnt, acc);
+        fprintf (of, "MMUOP %d %08X %d %08X ok %08X\n", op, va, lnt, acc, dat);
+        break;
+
+    case 4:                                             /* MTPR va -> IPR dat */
+        opnd[0] = (int32) va;
+        opnd[1] = dat;
+        op_mtpr (opnd);
+        fprintf (of, "MMUOP %d %08X %d %08X ok %08X\n", op, va, lnt, acc, dat);
+        break;
+
+    default:
+        return SCPE_ARG;
+        }
+return SCPE_OK;
+}
+
+t_stat cpu_set_mmutrace (UNIT *uptr, int32 val, CONST char *cptr, void *desc)
+{
+if (pcjs_mmu_log != NULL) {
+    fclose (pcjs_mmu_log);
+    pcjs_mmu_log = NULL;
+    }
+if (val == 0)                                           /* NOMMUTRACE */
+    return SCPE_OK;
+if ((cptr == NULL) || (*cptr == 0))
+    return SCPE_ARG;
+pcjs_mmu_log = fopen (cptr, "w");
+if (pcjs_mmu_log == NULL)
+    return SCPE_OPENERR;
+return SCPE_OK;
+}
+
