+/* pcjs-vax differential support (patch 0006). DBG_DEVT is a single machine-readable
+   trace covering every access that reaches ReadIPR/WriteIPR (console + timer IPR space)
+   or ReadReg/WriteReg (memory-mapped CQBIC/CMCTL/SSC/KA/CDG register space), so a device
+   harness has one oracle for all of it rather than reconstructing it from per-register
+   debug lines. Purely additive -- no instruction or register semantics change. */
+#define DBG_DEVT 0x0040 /* pcjs-vax: device register access trace (IPR + register space) */
 
 DEBTAB sysd_debug[] = {
   {"REGR", DBG_REGR,  "Interval TMR register read access"},
@@ -514,6 +520,7 @@ DEBTAB sysd_debug[] = {
