   {"TODR", DBG_TODR,  "TODR register access"},
   {"CNF",  DBG_CNF,   "CNF register access"},
+  {"DEVTRACE", DBG_DEVT, "pcjs-vax machine-readable device register access trace"},
   {0}
 };
 
